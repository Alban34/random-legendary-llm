{
  "name": "legendary-marvel-randomizer",
  "private": true,
  "version": "2.1.1",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "start": "vite build --base / && vite preview",
    "test": "vitest run",
    "test:qc": "playwright test",
    "test:qc:headed": "playwright test --headed",
    "e2e": "npx playwright test",
    "e2e:filter": "npx playwright test --grep",
    "report:epic1": "tsx ./tools/run_epic1_checks.ts",
    "build:shell": "python3 ./tools/build_epic1_index.py",
    "build:seed": "python3 ./tools/build_epic1_seed.py",
    "lint": "eslint src/ && svelte-check --tsconfig ./tsconfig.json",
    "typecheck": "svelte-check --tsconfig ./tsconfig.json",
    "build": "vite build",
    "preview": "vite preview",
    "test:coverage": "vitest run --coverage"
  },
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "@playwright/test": "^1.59.1",
    "@sveltejs/vite-plugin-svelte": "^5.0.0",
    "@types/node": "^25.6.0",
    "@vitest/coverage-v8": "^4.1.5",
    "esbuild": "^0.28.0",
    "eslint": "^9.0.0",
    "eslint-plugin-svelte": "^2.46.0",
    "jiti": "^2.6.1",
    "svelte": "^5.0.0",
    "svelte-check": "^4.4.6",
    "tsx": "^4.21.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.59.0",
    "vite": "^6.0.0",
    "vitest": "^4.1.5"
  },
  "dependencies": {
    "svelte-sonner": "^1.1.0"
  }
}
